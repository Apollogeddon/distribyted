package http

import "fmt"

templ torrentDetailView(p torrentPage) {
	@page(p.Title, "routes") {
		<nav class="crumbs" aria-label="Back">
			<ol>
				<li><a href="/routes">Routes</a></li>
				if p.Torrent.Route != "" {
					<li><span>{ p.Torrent.Route }</span></li>
				}
			</ol>
		</nav>
		if p.Missing {
			@pageHeader("Torrent", "")
			@emptyState("folders") {
				This torrent isn't in this route any more. <a href="/routes">Go to Routes</a>
			}
		} else {
			@pageHeader(p.Torrent.Name, "Its files, how ready each is to play, the links that show them, and its peers.") {
				<div class="header-actions">
					<button type="button" class="btn btn-secondary" hx-post={ p.PrepareURL } hx-swap="none">
						@icon("download")
						Start and end of every file
					</button>
					<button type="button" class="btn btn-secondary" hx-delete={ p.FreeURL } hx-swap="none" hx-confirm={ "Free what “" + p.Torrent.Name + "” has in the cache? Its pieces download again when it's next played." } data-confirm-title="Free cache" data-confirm-label="Free">
						@icon("hard-drive")
						Free cache
					</button>
					<button type="button" class="btn btn-danger" hx-delete={ p.DeleteURL } hx-swap="none" hx-confirm={ p.DeleteQuestion } data-confirm-title="Delete torrent" data-confirm-label="Delete">
						@icon("trash-2")
						Delete
					</button>
				</div>
			}
			<div class="field torrent-magnet">
				<label for="torrent-magnet">Magnet link</label>
				<div class="copy-row">
					<input type="text" id="torrent-magnet" class="input mono" readonly value={ p.Magnet }/>
					<button type="button" class="btn btn-secondary" data-copy="torrent-magnet">
						@icon("copy")
						<span>Copy</span>
					</button>
				</div>
			</div>
			@torrentDetailBody(p)
			<dialog id="file-dialog" aria-labelledby="file-dialog-title">
				<div id="file-dialog-body"></div>
			</dialog>
		}
	}
}

// torrentDetailBody is the part of a torrent's page that refreshes.
templ torrentDetailBody(p torrentPage) {
	<div id="torrent-body" class="stack" hx-get={ p.BodyURL } hx-trigger="every 5s [document.visibilityState === 'visible' && !document.querySelector('dialog[open]')], torrent-changed from:body, cache-changed from:body" hx-swap="morph:outerHTML" hx-ext="morph">
		if p.Missing {
			@emptyState("folders") {
				This torrent isn't in this route any more. <a href="/routes">Go to Routes</a>
			}
		} else {
			<section class="card torrent-summary" aria-label="Torrent">
				if len(p.Torrent.Pieces) > 0 {
					<div class="pieces" role="img" aria-label={ p.Torrent.Progress }>
						for _, s := range p.Torrent.Pieces {
							<span class={ s.Class } style={ "width: " + s.Width } title={ s.Label }></span>
						}
					</div>
					<p class="torrent-meta">{ p.Torrent.Progress } · { p.Torrent.PieceSize } pieces</p>
				}
				<p class="health">
					<span class={ "pill", "tone-" + p.Torrent.Health.Level }>{ p.Torrent.Health.Label }</span>
					if p.Torrent.Health.Reason != "" {
						<span class="health-text">{ p.Torrent.Health.Reason }</span>
					}
				</p>
				<dl class="facts">
					<div><dt>Download</dt><dd>{ p.Torrent.Down }</dd></div>
					<div><dt>Upload</dt><dd>{ p.Torrent.Up }</dd></div>
					<div><dt>Peers</dt><dd>{ fmt.Sprint(p.Torrent.Peers) } ({ fmt.Sprint(p.Torrent.Seeders) } seeding)</dd></div>
					<div><dt>Linked into the library</dt><dd>{ fmt.Sprintf("%d of %s", p.Linked, countOf(len(p.Files), "file")) }</dd></div>
				</dl>
			</section>
			<section class="card" aria-labelledby="torrent-files-title">
				<div class="card-header">
					<h2 id="torrent-files-title">Files</h2>
					<span class="card-meta">{ countOf(len(p.Files), "file") }</span>
				</div>
				if len(p.Files) == 0 {
					<p class="muted">The file list arrives with the torrent's metadata.</p>
				} else {
					<ul class="list">
						for _, f := range p.Files {
							<li class="tfile" id={ f.ID }>
								<div class="file-name">
									<span class="file-label">
										@icon("file")
										<a href={ templ.SafeURL(f.FolderHref) } title="Show in Files">{ f.Name }</a>
									</span>
									if f.ReadinessURL != "" {
										<button type="button" class={ "pill", "pill-button", templ.KV("tone-ok", f.Readiness == "ready"), templ.KV("tone-idle", f.Readiness != "ready") } hx-get={ f.ReadinessURL } hx-target="#file-dialog-body" hx-swap="innerHTML" title="How much of it is cached, and download it ahead">
											if f.Readiness == "ready" {
												Ready to play
											} else {
												Not cached
											}
											<span class="sr-only">: { f.Name }</span>
										</button>
									}
								</div>
								<span class="file-size">{ f.Size }</span>
								<div class="tfile-links">
									if len(f.LinkedFrom) == 0 {
										<span class="muted-inline">Not linked</span>
									} else {
										for _, l := range f.LinkedFrom {
											<span class="link-target small">
												@icon("link")
												{ l }
											</span>
										}
									}
								</div>
							</li>
						}
					</ul>
				}
			</section>
			<section class="card" aria-labelledby="torrent-peers-title">
				<div class="card-header">
					<h2 id="torrent-peers-title">Peers</h2>
					<span class="card-meta">{ countOf(len(p.Peers), "connected peer") }</span>
				</div>
				if len(p.Peers) == 0 {
					<p class="muted">No peers are connected. A torrent being read finds them from its trackers, the DHT and the peers it saved.</p>
				} else {
					<div class="table-scroll">
						<table class="peer-table">
							<thead>
								<tr><th scope="col">Address</th><th scope="col">Client</th><th scope="col">Found by</th><th scope="col">Has</th><th scope="col" class="num">Down</th><th scope="col" class="num">Up</th></tr>
							</thead>
							<tbody>
								for _, pr := range p.Peers {
									<tr id={ pr.ID }>
										<td class="mono">{ pr.Addr }</td>
										<td>{ pr.Client }</td>
										<td>{ pr.Source }</td>
										<td>
											if pr.Seed {
												<span class="pill tone-ok">Seeder</span>
											} else {
												{ pr.Have }
											}
										</td>
										<td class="num" data-label="Down">{ pr.Down }</td>
										<td class="num" data-label="Up">{ pr.Up }</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
			</section>
		}
	</div>
}
