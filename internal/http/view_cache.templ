package http

templ cacheView(p cachePage) {
	@page("Cache", "cache") {
		@pageHeader("Cache", "What the piece cache holds, torrent by torrent. The pieces read longest ago are evicted first as it fills.")
		@cacheList(p)
	}
}

// cacheList is the part of the Cache page that refreshes once a torrent's share is freed.
templ cacheList(p cachePage) {
	<section id="cache" class="stack" aria-label="Cache" hx-get="/cache/list" hx-trigger="cache-changed from:body, every 30s" hx-swap="morph:outerHTML" hx-ext="morph">
		if !p.HasCache {
			@emptyState("hard-drive") {
				The piece cache isn't in use.
			}
		} else {
			<div class="card kpi">
				<p class="kpi-label">
					@icon("hard-drive", "cache")
					Piece cache
				</p>
				<p class="kpi-value">{ p.Percent }% <span class="kpi-sub">{ p.Used } of { p.Capacity }</span></p>
				<div class="meter" role="meter" aria-label="Piece cache used" aria-valuemin="0" aria-valuemax="100" aria-valuenow={ p.Percent }>
					<span style={ p.Width() }></span>
				</div>
				if p.Protected != "" {
					<p class="kpi-note">{ p.Protected }.</p>
				}
			</div>
			if len(p.Torrents) == 0 {
				@emptyState("hard-drive") {
					Nothing is cached yet. A torrent's pieces are kept here as they're read.
				}
			} else {
				<div class="card">
					<ul class="list">
						for _, t := range p.Torrents {
							<li class="cached" id={ t.ID }>
								<div class="cached-main">
									<p class="cached-name">
										if t.Href != "" {
											<a href={ templ.SafeURL(t.Href) }>{ t.Name }</a>
										} else {
											{ t.Name }
										}
									</p>
									<div class="meter" aria-hidden="true"><span style={ t.Width() }></span></div>
									<p class="cached-meta">
										<span>{ t.Size } · { t.Percent }% of the cache</span>
										<span>{ t.Pieces }</span>
										if t.LastRead != "" {
											<span>{ t.LastRead }</span>
										}
									</p>
								</div>
								<button type="button" class="btn btn-secondary" hx-delete={ t.FreeURL } hx-swap="none" hx-confirm={ t.FreeQuestion } data-confirm-title="Free cache" data-confirm-label="Free">
									Free<span class="sr-only"> { t.Name }</span>
								</button>
							</li>
						}
					</ul>
				</div>
			}
			if p.Other != "" {
				<p class="filter-count">{ p.Other }</p>
			}
		}
		@downloads(p)
	</section>
}

// downloads says what was downloaded and why, so downloading with nothing playing can be
// explained.
templ downloads(p cachePage) {
	<div class="card">
		<div class="card-header">
			<h2>Downloaded</h2>
			<span class="card-meta">since distribyted started, { p.Downloads.Since }</span>
		</div>
		<div class="table-scroll">
			<table class="data-table downloads-table">
				<thead>
					<tr>
						<th scope="col">Why</th>
						<th scope="col" class="num">Last day</th>
						<th scope="col" class="num">In all</th>
					</tr>
				</thead>
				<tbody>
					for _, r := range p.Downloads.Rows {
						<tr>
							<th scope="row">
								{ r.Reason }
								if r.Again != "" {
									<span class="row-note">{ r.Again }</span>
								}
							</th>
							<td class="num">{ r.Day }</td>
							<td class="num">{ r.Total }</td>
						</tr>
					}
				</tbody>
				<tfoot>
					<tr>
						<th scope="row">All</th>
						<td class="num">{ p.Downloads.Day }</td>
						<td class="num">{ p.Downloads.Total }</td>
					</tr>
				</tfoot>
			</table>
		</div>
		<p class="card-foot">
			Read is a player or another app reading through the mount, and what's downloaded ahead of it.
			if p.FirstByte != "" {
				{ " " + p.FirstByte }
			}
		</p>
	</div>
}
