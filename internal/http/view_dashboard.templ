package http

import "fmt"

templ dashboardView(st dashboardStats) {
	@page("Dashboard", "dashboard") {
		@dashboardStatsView(st)
	}
}

// dashboardStatsView is the dashboard, which refreshes every couple of seconds.
templ dashboardStatsView(st dashboardStats) {
	<div id="stats" class="dashboard" hx-get="/dashboard/stats" hx-trigger="every 2s [document.visibilityState === 'visible']" hx-swap="morph:outerHTML" hx-ext="morph">
		<div class="dash-top">
			<h1>Dashboard</h1>
			<p class="verdict" role="status">
				{ st.Verdict }
				if st.Problem != "" {
					<strong>{ st.Problem }</strong>
				}
			</p>
		</div>
		<section class="status-line" aria-label="Now">
			<div class="status-item">
				<p class="status-label">Download</p>
				<p class="status-value">{ st.Down }</p>
				if st.DownSpark != "" {
					<svg class="spark down" viewBox="0 0 100 22" preserveAspectRatio="none" aria-hidden="true"><polyline points={ st.DownSpark } vector-effect="non-scaling-stroke"></polyline></svg>
				}
			</div>
			<div class="status-item">
				<p class="status-label">Upload</p>
				<p class="status-value">{ st.Up }</p>
				if st.UpSpark != "" {
					<svg class="spark up" viewBox="0 0 100 22" preserveAspectRatio="none" aria-hidden="true"><polyline points={ st.UpSpark } vector-effect="non-scaling-stroke"></polyline></svg>
				}
			</div>
			<div class="status-item">
				<p class="status-label">Streams</p>
				<p class="status-value">{ fmt.Sprint(st.Streams) }</p>
				if st.Waiting > 0 {
					<p class="status-note warn">{ fmt.Sprint(st.Waiting) } waiting for data</p>
				} else {
					<p class="status-note">None waiting</p>
				}
			</div>
			<a class="status-item" href="/routes?sort=attention">
				<p class="status-label">Torrents</p>
				<p class="status-value">{ fmt.Sprint(st.Torrents) }</p>
				if st.ShortOfPeers > 0 {
					<p class="status-note go">{ fmt.Sprint(st.ShortOfPeers) } short of seeders</p>
				} else {
					<p class="status-note go">All well seeded</p>
				}
			</a>
			<a class="status-item" href="/links?show=attention">
				<p class="status-label">Links</p>
				<p class="status-value">{ fmt.Sprint(st.Links) }</p>
				<p class="status-note go">{ st.LinksNote() }</p>
			</a>
			<a class="status-item" href="/cache">
				<p class="status-label">Cache</p>
				if st.HasCache {
					<p class="status-value">{ fmt.Sprint(st.CachePercent) }%</p>
					<p class="status-note go">{ st.CacheUsed } of { st.CacheCapacity }</p>
					<div class="status-gauge" role="meter" aria-label="Piece cache used" aria-valuemin="0" aria-valuemax="100" aria-valuenow={ fmt.Sprint(st.CachePercent) }><span style={ st.CacheWidth() }></span></div>
				} else {
					<p class="status-value">Off</p>
				}
			</a>
		</section>
		@nowPlaying(st.Playing)
		<section class="card" aria-labelledby="speed-title">
			<div class="card-header">
				<h2 id="speed-title">Speed, last minute</h2>
				<ul class="legend">
					<li><span class="swatch down"></span> Download</li>
					<li><span class="swatch up"></span> Upload</li>
				</ul>
			</div>
			@speedChart(st.Chart)
		</section>
	</div>
}

// nowPlaying is the files being read now, as a player streams them, each on a rail that
// shows what has played, what's cached ahead, and which parts of the file are cached.
templ nowPlaying(ps []playingView) {
	<section class="card" aria-labelledby="playing-title">
		<div class="card-header">
			<h2 id="playing-title">Now playing</h2>
			if len(ps) > 0 {
				<span class="card-meta">{ countOf(len(ps), "stream") }</span>
			}
		</div>
		if len(ps) == 0 {
			<p class="muted">Nothing is being read. A file shows here while a player streams it.</p>
		} else {
			<ul class="list">
				for _, p := range ps {
					<li class="stream" id={ p.ID }>
						<div class="stream-head">
							<div class="stream-title">
								<p class="stream-name">{ p.Title }</p>
								if p.Source != "" {
									<p class="stream-source">{ p.Source }</p>
								}
							</div>
							<span class={ "pill", "tone-" + p.Status.Level }>{ p.Status.Label }</span>
						</div>
						<div class="rail" role="img" aria-label={ p.Position + ", " + p.Buffer }>
							<span class="rail-buffer" style={ p.BufferedWidth() }></span>
							<span class="rail-played" style={ p.PlayedWidth() }></span>
							<span class="rail-head" style={ p.HeadLeft() }></span>
						</div>
						if len(p.Cached) > 0 {
							<div class="cached-map" aria-hidden="true" title="Which parts of the file are cached">
								for _, c := range p.Cached {
									<i class={ templ.KV("on", c) }></i>
								}
							</div>
						}
						<p class="stream-facts">
							<span>{ p.Position }</span>
							<span>{ p.Buffer }</span>
							<span>{ p.Transfer }</span>
						</p>
						if p.Status.Level == "warn" && p.Status.Reason != "" {
							<p class="stream-why">
								{ p.Status.Reason }
								if p.TorrentHref != "" {
									<a href={ templ.SafeURL(p.TorrentHref) }>Open the torrent</a>
								}
							</p>
						}
					</li>
				}
			</ul>
		}
	</section>
}

templ speedChart(cv chartView) {
	<div class="chart">
		<div class="chart-axis" aria-hidden="true">
			for _, t := range cv.Ticks {
				<span style={ "top: " + t.Top() }>{ t.Label }</span>
			}
		</div>
		<div class="chart-plot">
			<svg viewBox="0 0 300 100" preserveAspectRatio="none" role="img" aria-label={ cv.Label }>
				for _, t := range cv.Ticks {
					<line class="chart-grid" x1="0" x2="300" y1={ t.Y } y2={ t.Y } vector-effect="non-scaling-stroke"></line>
				}
				if cv.DownLine != "" {
					<path class="chart-area" d={ cv.DownArea }></path>
					<path class="chart-line up" d={ cv.UpLine } vector-effect="non-scaling-stroke"></path>
					<path class="chart-line down" d={ cv.DownLine } vector-effect="non-scaling-stroke"></path>
				}
			</svg>
			if cv.DownLine == "" {
				<p class="chart-empty">Collecting the first few seconds…</p>
			}
		</div>
	</div>
}
